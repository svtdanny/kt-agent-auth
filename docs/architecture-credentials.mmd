flowchart LR
    VAULT["Vault<br/>Project source credentials + encryption key"] --> CI["GitLab CI"]
    PROVISION["Database provisioner<br/>Project DB + LOGIN + password"]
    subgraph PROJECT_A["namespace: auth-agent-a"]
        SOURCE["Secret: application-credentials<br/>credentials.json"]
        KEY["Secret: auth-state-key<br/>32-byte key K_a, base64 file"]
        DBSECRET["Secret: authorizer-db<br/>DATABASE_URL"]
        subgraph DEPLOYMENT["Deployment: agent-egress — replicas G_a"]
            subgraph POD["egress Pod × G_a"]
                AUTH["authorizer<br/>OAuth resolver + pkg/authstate<br/>On token use: SQL recheck if last check ≥ 1 second ago<br/>pgx pool: max 4 connections"]
                ENVOY["Envoy"]
                AUTH -->|"Derived bearer token"| ENVOY
            end
        end
        SOURCE -.->|"Read-only file mount"| AUTH
        KEY -.->|"Read-only file mount"| AUTH
        DBSECRET -.->|"Environment variable"| AUTH
    end
    CI -.-> SOURCE
    CI -.-> KEY
    PROVISION -.-> DBSECRET
    subgraph PROJECT_B["namespace: auth-agent-b"]
        BSECRETS["Own source credentials + K_b + DB password"]
        BAUTH["Project B authorizer replicas"]
        BSECRETS -.-> BAUTH
    end
    subgraph POSTGRES["Shared PostgreSQL server — namespace: kagent"]
        subgraph DBA["Database: auth_agent_a / LOGIN + OWNER: auth_agent_a"]
            TOKENS["auth_state.tokens<br/>Encrypted token, version, refresh lease, cooldown"]
            BINDINGS["auth_bridge.bindings<br/>Immutable Session identity + revocation"]
            LAUNCHES["auth_bridge.launches<br/>Idempotent Session creation"]
        end
        DBB["Database: auth_agent_b / LOGIN + OWNER: auth_agent_b<br/>Own copies of the same schemas/tables"]
        PLATFORM["Platform databases / own roles"]
    end
    AUTH -->|"Direct SQL / verified TLS / SCRAM-SHA-256"| DBA
    BAUTH -->|"Direct SQL / verified TLS / SCRAM-SHA-256"| DBB
    AUTH -->|"HTTPS acquisition — refresh lease holder only"| OAUTH["External OAuth endpoint"]
