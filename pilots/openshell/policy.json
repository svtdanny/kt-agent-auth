{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": true,
    "read_only": [
      "/usr",
      "/lib",
      "/etc",
      "/app",
      "/proc",
      "/dev/urandom",
      "/var/log"
    ],
    "read_write": [
      "/tmp",
      "/dev/null",
      "/sandbox"
    ]
  },
  "landlock": {
    "compatibility": "hard_requirement"
  },
  "network_policies": {
    "mcp": {
      "endpoints": [
        {
          "host": "mock-mcp.test-services.svc.cluster.local",
          "port": 8080,
          "protocol": "rest",
          "enforcement": "enforce",
          "rules": [
            {
              "allow": {
                "method": "POST",
                "path": "/mcp"
              }
            }
          ],
          "allowed_ips": [
            "10.96.0.0/12"
          ],
          "credential_binding": {
            "provider": "pilot-mcp"
          }
        }
      ],
      "binaries": [
        {
          "path": "/usr/local/bin/node"
        },
        {
          "path": "/usr/bin/curl"
        }
      ]
    },
    "external": {
      "endpoints": [
        {
          "host": "external-api.auth-demo.test",
          "port": 8443,
          "protocol": "rest",
          "enforcement": "enforce",
          "rules": [
            {
              "allow": {
                "method": "GET",
                "path": "/external"
              }
            }
          ],
          "allowed_ips": [
            "192.168.58.0/24"
          ],
          "credential_binding": {
            "provider": "pilot-external"
          }
        }
      ],
      "binaries": [
        {
          "path": "/usr/local/bin/node"
        },
        {
          "path": "/usr/bin/curl"
        }
      ]
    }
  }
}
