FROM node:22.22.1-bookworm-slim
COPY .cache/build/store-tests /app/store-tests
COPY .cache/build/authstate-tests /app/authstate-tests
COPY .cache/build/credential-tests /app/credential-tests
USER 65532:65532
ENTRYPOINT ["/bin/sh", "-ec", "/app/store-tests -test.v; /app/authstate-tests -test.v; /app/credential-tests -test.v"]
